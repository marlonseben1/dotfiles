# Copy this file to ~/.config/fedora-setup.env and fill in your real values.
# ~/.config/fedora-setup.env is NOT tracked by git — it is sourced by config/.zshrc
# so personal/work emails and repo paths never end up in this repo's history.

SYNC_EMAIL_PERSONAL="you@example.com"
SYNC_EMAIL_WORK="you@company.com"
SYNC_SOURCE_REPOS=("$HOME/Projetos/your-work-repo" "$HOME/Projetos/another-work-repo")
SYNC_LOG_REPO="$HOME/Projetos/your-activity-log-repo"
