{
	"relative_line_numbers": "enabled",
 "cli_default_open_behavior": "existing_window",
 "agent_servers": {
		"claude-acp": {
			"default_config_options": {
				"mode": "auto"
			},
			"type": "registry"
		}
	},
	"soft_wrap": "editor_width",
	"edit_predictions": {
		"mode": "subtle"
	},
	"vim": {
		"cursor_shape": {
			"normal": "hollow"
		}
	},
	"cursor_shape": "underline",
	"lsp": {
		"vtsls": {
			"settings": {
				"typescript": {
					"updateImportsOnFileMove": {
						"enabled": "always"
					}
				},
				"javascript": {
					"updateImportsOnFileMove": {
						"enabled": "always"
					}
				}
			},
			"enable_lsp_tasks": true
		}
	},
	"format_on_save": "on",

	"languages": {
		"JavaScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.organizeImports.biome": true
			}
		},
		"JSX": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.organizeImports.biome": true
			}
		},
		"TSX": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.organizeImports.biome": true
			}
		},
		"JSON": {
			"formatter": { "language_server": { "name": "biome" } }
		},
		"JSONC": {
			"formatter": { "language_server": { "name": "biome" } }
		}
	},

	"git_panel": {
		"group_by": "none",
  "tree_view": true,
  "entry_primary_click_action": "file_diff",
  "dock": "left"
	},
	"agent": {
		"default_model": {
			"provider": "anthropic",
			"model": "claude-sonnet-5",
			"enable_thinking": true,
			"effort": "high"
		},
		"play_sound_when_agent_done": "always",
		"thinking_display": "always_collapsed",
		"use_modifier_to_send": true,
		"dock": "right",
		"sidebar_side": "right",
		"favorite_models": [],
		"model_parameters": []
	},
	"icon_theme": "Catppuccin Macchiato",
	"project_panel": {
		"dock": "left"
	},
	"session": {
		"trust_all_worktrees": true
	},
	"vim_mode": true,
	"minimap": {
		"show": "always"
	},
	"base_keymap": "VSCode",
	"ui_font_size": 16,
	"buffer_font_size": 15,
	"theme": {
		"mode": "dark",
		"light": "Everforest Light Hard (regular)",
		"dark": "Min Dark (Solid)"
	}
}
